# Copy values into the process environment or your deployment secret store.
# Spring Boot does not load .env files automatically.
DB_URL=jdbc:postgresql://localhost:5439/facelit-db
DB_USERNAME=facelit_user
DB_PASSWORD=replace-with-a-private-password
JWT_SECRET=replace-with-a-private-random-secret-of-at-least-32-bytes
MAIL_USERNAME=replace-with-smtp-account
MAIL_PASSWORD=replace-with-smtp-secret
FACIAL_EMBEDDING_URL=http://localhost:8090
FACIAL_EMBEDDING_API_KEY=replace-with-a-private-service-key
FACELIT_ALLOWED_ORIGINS=http://localhost:8081
FACELIT_ACCESS_URL=http://localhost:8081
FACELIT_COORDINATOR_BOOTSTRAP=false
FACELIT_COORDINATOR_ROTATE_PASSWORD=false
FACELIT_COORDINATOR_EXIT_AFTER=false
# Set bootstrap document/name/email/password only for the one-off bootstrap run.
