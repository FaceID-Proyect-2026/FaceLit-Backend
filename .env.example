# Local configuration only. Copy to .env; never commit actual credentials.
DB_URL=jdbc:postgresql://127.0.0.1:5439/facelit-db
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=
FACIAL_EMBEDDING_URL=http://127.0.0.1:8090
FACIAL_EMBEDDING_API_KEY=
FACELIT_ALLOWED_ORIGINS=http://localhost:8081
FACELIT_ACCESS_URL=http://localhost:8081

# One-time coordinator setup. Prefer scripts/initialize-coordinator.ps1 with hidden input.
# Leave disabled during normal operation; no default account or password is supplied.
FACELIT_COORDINATOR_BOOTSTRAP=false
FACELIT_COORDINATOR_ROTATE_PASSWORD=false
FACELIT_COORDINATOR_EXIT_AFTER=false
FACELIT_COORDINATOR_DOCUMENT=
FACELIT_COORDINATOR_FIRST_NAME=
FACELIT_COORDINATOR_LAST_NAME=
FACELIT_COORDINATOR_EMAIL=
FACELIT_COORDINATOR_PASSWORD=
